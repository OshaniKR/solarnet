# Copy to .env (or just leave the defaults baked into docker-compose.yml alone --
# they match these values already).

POSTGRES_USER=solarnet
POSTGRES_PASSWORD=solarnet
POSTGRES_DB=solarnet

# 1 simulated day = this many real seconds. 300 = 5 minutes, per the brief's
# suggested default. Lower it (e.g. 60) for a faster demo loop while developing.
SIM_DAY_SECONDS=300

NUM_HOUSEHOLDS=40

# Alert thresholds (see observability/alert_rules.yml and api/main.py)
NO_DATA_ALERT_MINUTES=3
LOW_SOLAR_SHARE_PCT=15
